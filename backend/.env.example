PORT=4000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=schema

# Admin login (change before the event!)
ADMIN_PASSWORD=change-me
JWT_SECRET=change-this-to-a-long-random-string

# Key the Live Draw page must send before it can draw (so not just anyone can press the button)
DRAW_KEY=change-me-too

# Public randomness beacon (drand). "off" = local randomness only (e.g. no internet at the venue)
BEACON=on
